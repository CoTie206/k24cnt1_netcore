@{
	ViewData["Title"] = "Danh sách tài khoản";
	var hctAccounts = ViewBag.HctAccounts;
}
<div class="row">
	@foreach (HctAccount item in hctAccounts)
	{
		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="img-fluid">
						<img src="@item.Avatar" alt="@item.Name" class="w-100" />
					</div>
					<div class="">
						<h3>@item.Name</h3>
						<p>@item.Bio</p>
						<a asp-route="HctProfile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
					</div>
				</div>
			</div>

		</div>
	}

</div>
