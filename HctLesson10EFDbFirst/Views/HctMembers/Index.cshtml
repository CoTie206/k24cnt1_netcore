@model IEnumerable<HctLesson10EFDbFirst.Models.HctMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HctUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.HctUserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HctPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HctFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HctEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HctPhone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HctStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
