@model IEnumerable<HctLession07Model.Models.DataModels.HctMember>

@{
	ViewData["Title"] = "Danh sách thành viên";
}
<div class="card p-3">
	<h1>@ViewData["Title"]</h1>
	<p>
		<a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
	</p>
	<table class="table table-bordered table-striped">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.HctMemberId)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.HctUserName)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.HctPassword)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.HctFullName)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.HctEmail)
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
	

		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.HctMemberId)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.HctUserName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.HctPassword)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.HctFullName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.HctEmail)
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.HctMemberId">Edit</a> |
					<a asp-action="Details" asp-route-id="@item.HctMemberId">Details</a> |
					<a asp-action="Delete" asp-route-id="@item.HctMemberId">Delete</a>
				</td>
			</tr>
		}

		</tbody>
	</table>
</div>