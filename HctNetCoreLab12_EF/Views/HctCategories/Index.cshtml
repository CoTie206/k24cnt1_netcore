@model IEnumerable<HctNetCoreLab12_EF.Models.HctCategory>

@{
    ViewData["Title"] = "Danh sách danh mục";
}

<h1>Danh sách danh mục</h1>

<p>
    <a class="btn btn-sm btn-success" asp-action="Create">Thêm mới danh mục</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HctName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HctCreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HctName)
            </td>
            <td>
                @Html.DisplayFor(model => item.HctStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.HctCreatedDate)
            </td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.HctID">Edit</a> |
                <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@item.HctID">Details</a> |
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.HctID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
